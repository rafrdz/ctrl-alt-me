{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/ctrlaltme",
      "args": [
        "api",
        "--env", "${env:APP_ENV}",
        "--version", "1.0.0",
        "--port", "${env:PORT}",
        "--db-dsn", "postgresql://${env:DATABASE_USER}:${env:DATABASE_PASSWORD}@${env:DATABASE_HOST}:${env:DATABASE_PORT}/${env:DATABASE_NAME}?sslmode=disable"
      ],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}"
    }
  ]
}