<%= link_to job_application_path(app), class: "block bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-4 py-3 hover:border-gray-300 dark:hover:border-gray-600 hover:shadow-sm transition-all group" do %>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-medium text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"><%= app.company %></span>
        <%= status_badge(app.status) %>
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5 truncate"><%= app.position %></p>
    </div>
    <div class="text-xs text-gray-400 dark:text-gray-500 shrink-0 mt-0.5">
      <% if app.applied_on %>
        Applied on <%= app.applied_on.strftime("%b %-d, %Y") %>
      <% end %>
    </div>
  </div>
<% end %>
