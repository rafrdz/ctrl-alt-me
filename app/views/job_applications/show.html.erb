<div class="max-w-2xl mx-auto">
  <%# Back + actions %>
  <div class="flex items-center justify-between mb-6">
    <%= link_to "← All applications", job_applications_path, class: "text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white" %>
    <div class="flex gap-3">
      <%= link_to "Edit", edit_job_application_path(@job_application),
          class: "text-sm rounded-md px-3 py-1.5 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 font-medium transition-colors" %>
      <%= button_to "Delete", job_application_path(@job_application), method: :delete,
          data: { turbo_confirm: "Remove this application?" },
          class: "text-sm rounded-md px-3 py-1.5 border border-red-200 dark:border-red-700 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 font-medium cursor-pointer transition-colors" %>
    </div>
  </div>

  <%# Header %>
  <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-6 py-5 mb-4 transition-colors">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-gray-900 dark:text-white"><%= @job_application.company %></h1>
        <p class="text-gray-600 dark:text-gray-400 mt-0.5"><%= @job_application.position %></p>
      </div>
      <%= status_badge(@job_application.status) %>
    </div>

    <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
      <% if @job_application.applied_on %>
        <div>
          <dt class="text-gray-500 dark:text-gray-400">Applied</dt>
          <dd class="font-medium text-gray-900 dark:text-white"><%= @job_application.applied_on.strftime("%B %-d, %Y") %></dd>
        </div>
      <% end %>

      <% if @job_application.link.present? %>
        <div>
          <dt class="text-gray-500 dark:text-gray-400">Job posting</dt>
          <dd><%= link_to "View posting →", @job_application.link, target: "_blank", rel: "noopener noreferrer",
              class: "font-medium text-blue-600 dark:text-blue-400 hover:underline" %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# Notes %>
  <% if @job_application.notes.present? %>
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-6 py-5 transition-colors">
      <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Notes</h2>
      <div class="prose prose-sm max-w-none text-gray-700 dark:text-gray-300">
        <%= render_markdown(@job_application.notes) %>
      </div>
    </div>
  <% end %>

  <%# Timeline %>
  <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-6 py-5 mt-4 transition-colors">
    <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-4">Timeline</h2>

    <% activities = @job_application.activities.chronological %>
    <% if activities.any? %>
      <div class="relative ml-3 border-l-2 border-gray-200 dark:border-gray-600 pl-6 space-y-6 mb-6">
        <% activities.each do |activity| %>
          <div class="relative">
            <div class="absolute -left-[31px] top-1 w-3 h-3 rounded-full bg-blue-500 dark:bg-blue-400 border-2 border-white dark:border-gray-800"></div>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-medium text-gray-900 dark:text-white"><%= event_type_label(activity.event_type) %></p>
                <% if activity.description.present? %>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5"><%= activity.description %></p>
                <% end %>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= activity.occurred_on.strftime("%b %-d, %Y") %></p>
              </div>
              <%= button_to job_application_activity_path(@job_application, activity), method: :delete,
                  data: { turbo_confirm: "Remove this activity?" },
                  class: "text-gray-400 dark:text-gray-500 hover:text-red-500 dark:hover:text-red-400 shrink-0 cursor-pointer" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400 dark:text-gray-500 mb-4">No activity logged yet.</p>
    <% end %>

    <%# Add activity form %>
    <details class="group">
      <summary class="text-sm font-medium text-blue-600 dark:text-blue-400 cursor-pointer hover:underline list-none">+ Add event</summary>
      <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
        <%= form_with model: Activity.new, url: job_application_activities_path(@job_application), class: "space-y-3" do |form| %>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <%= form.label :event_type, "Event type", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
              <%= form.select :event_type, Activity.event_types.keys.map { |e| [event_type_label(e), e] },
                  { include_blank: false },
                  class: "block w-full rounded-md border border-gray-300 dark:border-gray-600 shadow-sm px-3 py-2 bg-white dark:bg-gray-700 dark:text-gray-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
            <div>
              <%= form.label :occurred_on, "Date", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
              <%= form.date_field :occurred_on, value: Date.today,
                  class: "block w-full rounded-md border border-gray-300 dark:border-gray-600 shadow-sm px-3 py-2 bg-white dark:bg-gray-700 dark:text-gray-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            </div>
          </div>
          <div>
            <%= form.label :description, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
            <%= form.text_area :description, rows: 2, placeholder: "Details (optional)",
                class: "block w-full rounded-md border border-gray-300 dark:border-gray-600 shadow-sm px-3 py-2 bg-white dark:bg-gray-700 dark:text-gray-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          <%= form.submit "Add event", class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer transition-colors" %>
        <% end %>
      </div>
    </details>
  </div>
</div>
